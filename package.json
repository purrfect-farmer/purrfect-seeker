{
  "name": "purrfect-seeker",
  "version": "1.0.0",
  "description": "Registry of Purrfect servers and their addresses",
  "type": "module",
  "main": "app.js",
  "bin": {
    "seeker": "./seeker"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "start": "fastify start -l info app.js",
    "dev": "fastify start -w -l info -P app.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:migrate:refresh": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo",
    "db:seed:undo:all": "sequelize-cli db:seed:undo:all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.5.1",
    "@fastify/cors": "^11.3.1",
    "@fastify/sensible": "^6.0.7",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "crypto-random-string": "^6.0.0",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "fastify-cli": "^8.0.3",
    "fastify-plugin": "^6.0.1",
    "inquirer": "^14.2.4",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "sqlite3": "^6.0.1"
  }
}
